# Copy to .env only if using a dotenv loader or export these values in PowerShell.
# Never commit the real .env file or API keys.

# Required for online Gemini runs
GEMINI_API_KEY=
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
LLM_TIMEOUT_SECONDS=60

# Optional Anthropic provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional sandbox configuration
USE_DOCKER=0

# Production database. Leave unset to use local SQLite (RUN_DB_PATH).
# Use the pooled connection string from Neon or Supabase.
DATABASE_URL=
RUN_DB_PATH=runs.db

# Comma-separated browser origins. Use the exact Vercel URL in production.
CORS_ORIGINS=http://localhost:5173
